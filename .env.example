# Environment variables example for TMDB-To-VOD-Playlist
# Create a file named .env in the project root (do NOT commit it to the public repo)

TMDB_API_KEY=your_tmdb_api_key_here
REALDEBRID_TOKEN=
PREMIUMIZE_KEY=
HEADLESSVIDX_ADDR=localhost:3202
INCLUDE_ADULT_VOD=false
USER_SET_HOST=
USE_HTTP_PROXY=false
HTTP_PROXY=
HEADLESSVIDX_MAX_THREADS=5
TOTAL_PAGES=25
LANGUAGE=en-US
MAX_RESOLUTION=1080
